# PhishGuard runtime configuration. Copy to .env and fill in values.
# All settings can also be provided as real environment variables.

# --- Mailbox (IMAP) connection ---
PG_IMAP_SERVER=imap.example.com
PG_IMAP_USERNAME=user@example.com
PG_IMAP_PASSWORD=change_me
PG_IMAP_USE_SSL=true
PG_IMAP_PORT=993
PG_IMAP_MAILBOX=INBOX
PG_IMAP_UNSEEN_ONLY=true

# --- Optional: VirusTotal ---
PG_VT_API_KEY=
PG_VT_ENABLED=false

# --- Optional: Google Safe Browsing ---
PG_GSB_API_KEY=
PG_GSB_ENABLED=false

# --- Optional: ClamAV (network socket) ---
PG_CLAMAV_HOST=127.0.0.1
PG_CLAMAV_PORT=3310
PG_CLAMAV_ENABLED=false

# --- Optional: sandbox provider (ClamAV is built-in; Joe/CAPE via API later) ---
PG_SANDBOX_ENABLED=false
PG_SANDBOX_PROVIDER=
PG_SANDBOX_API_KEY=
PG_SANDBOX_URL=

# --- Monitoring loop ---
PG_MONITOR_ENABLED=false
PG_MONITOR_INTERVAL=60

# --- Behavioral BEC baseline ---
PG_BEHAVIORAL_ENABLED=false
PG_BEHAVIORAL_BASELINE_DAYS=30

# --- Organization profile (JSON file path) ---
PG_ORG_PROFILE_PATH=org_profile.json

# --- Web dashboard ---
PG_WEB_HOST=127.0.0.1
PG_WEB_PORT=8080
PG_WEB_USERNAME=admin
PG_WEB_PASSWORD=change_me
PG_WEB_SECRET_KEY=change_me_to_a_long_random_string

# --- Storage ---
PG_REPORT_DIR=./reports

# --- Remediation (post-delivery only; not a pre-delivery gateway) ---
PG_REMEDIATION_ENABLED=false
PG_REMEDIATION_PROVIDER=      # m365 | gmail
PG_M365_TENANT_ID=
PG_M365_CLIENT_ID=
PG_M365_CLIENT_SECRET=
PG_GMAIL_SA_JSON=

# --- SIEM export ---
PG_EXPORT_ENABLED=false
PG_EXPORT_SYSLOG_ADDR=        # host:port (UDP)
PG_EXPORT_CEF=false
PG_EXPORT_WEBHOOK_URL=
PG_EXPORT_MIN_SEVERITY=medium

# --- Engine tuning ---
PG_THRESHOLD_SUSPICIOUS=30
PG_THRESHOLD_PHISHING=60
PG_THRESHOLD_MALICIOUS=85
PG_DNS_CHECKS_ENABLED=false

# Comma separated list of trusted/internal domains (lower scrutiny)
PG_TRUSTED_DOMAINS=

PG_LOG_LEVEL=INFO
